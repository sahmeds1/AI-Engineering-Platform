
CHATBOT_APP_NAME=Agentic AI Chatbot
CHATBOT_ENVIRONMENT=development
CHATBOT_DEBUG=true
CHATBOT_LOG_LEVEL=DEBUG
CHATBOT_API_VERSION=v1
CHATBOT_REQUEST_TIMEOUT_SECONDS=30
CHATBOT_MAX_CONVERSATION_HISTORY=20
CHATBOT_ALLOWED_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
OPENAI_API_KEY=your_test_key_here
CHATBOT_EXTERNAL_SERVICE_TIMEOUT_SECONDS=5
CHATBOT_MAX_CONCURRENT_EXTERNAL_REQUESTS=3
CHATBOT_JWT_SECRET_KEY=replace-with-a-long-random-secret-before-running
CHATBOT_JWT_ALGORITHM=HS256
CHATBOT_JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30